# ============================================================
# Alpha Terminal — Backend Configuration
# ============================================================

# Application Settings
# Database backend to use: "supabase" (production), "sqlite" (local file), or "mock" (in-memory testing)
DATABASE_BACKEND=supabase

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Timeout in seconds before a running research job is considered stale and failed
RESEARCH_JOB_TIMEOUT_SECONDS=3600

# Supabase Persistence & Auth (Required when DATABASE_BACKEND=supabase)
# Your Supabase project URL (e.g., https://your-project-id.supabase.co)
SUPABASE_URL=

# Supabase service role secret key (server-side only, never expose to frontend)
SUPABASE_SECRET_KEY=

# AI / Multi-Agent LLM (Required for executing AI research pipeline)
# Google Gemini API key
GEMINI_API_KEY=

# Market / Financial Data Providers
# SEC EDGAR user agent header required by SEC fair access policy (Format: Sample Company Name AdminContact@domain.com)
SEC_USER_AGENT=

# Marketaux API key for financial news retrieval (optional, fallback used if omitted)
MARKETAUX_API_KEY=

# CORS Configuration
# Allowed CORS origins as a JSON array string or comma-separated URLs
# Note: Wildcard '*' is strictly prohibited for security
CORS_ORIGINS=["http://localhost:5173"]