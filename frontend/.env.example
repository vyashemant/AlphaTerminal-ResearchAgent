# ============================================================
# Alpha Terminal — Frontend Configuration
# ============================================================
# SECURITY NOTICE:
# Variables prefixed with VITE_ are embedded into the client
# JavaScript bundle at build time and are publicly visible in
# the browser. NEVER put secret keys or private credentials here.
# ============================================================

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8000

# Supabase Public Configuration
# Your Supabase project URL (e.g., https://your-project-id.supabase.co)
VITE_SUPABASE_URL=

# Supabase public anonymous key (safe for browser exposure)
VITE_SUPABASE_ANON_KEY=
